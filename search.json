---
layout: null
permalink: /search.json
---
[
{% assign written = false %}
{% for post in site.posts %}
{% if written %},{% endif %}
  {"title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 220 | jsonify }}, "categories": {{ post.categories | jsonify }}, "tags": {{ post.tags | jsonify }}, "date": {{ post.date | date: "%Y-%m-%d" | jsonify }}, "kind": "writeup", "event": {{ post.event | default: "" | jsonify }}}
{% assign written = true %}
{% endfor %}
{% for event in site.events %}
{% if written %},{% endif %}
  {"title": {{ event.title | jsonify }}, "url": {{ event.url | relative_url | jsonify }}, "excerpt": {{ event.description | default: "" | strip_html | strip_newlines | truncate: 220 | jsonify }}, "categories": [], "tags": [], "date": {{ event.date | date: "%Y-%m-%d" | jsonify }}, "kind": "event", "event": ""}
{% assign written = true %}
{% endfor %}
]
